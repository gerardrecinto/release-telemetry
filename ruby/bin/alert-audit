#!/usr/bin/env ruby
require_relative "../lib/alert_audit"

path = ARGV[0] || File.expand_path("../../alerts/alerts.yml", __dir__)
findings = AlertAudit.audit_file(path)
findings.each { |f| puts "FAIL #{f.rule} #{f.condition}: #{f.message}" }
puts(findings.empty? ? "alerts ok" : "#{findings.size} finding(s)")
exit(findings.empty? ? 0 : 1)
